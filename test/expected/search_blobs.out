-- The blobs behind a chdb index: its store tables keep their parts on
-- libchdb's callback object storage, one storage per index, whose blobs the
-- database's worker holds and chdb_search_blobs lists. The server needs
-- libchdb on its library path, for chdb_search_engine.
\set VERBOSITY terse
SET client_min_messages = warning;
CREATE EXTENSION chdb_search;
SET search_path = public, chdb;
CREATE TABLE docs (id int PRIMARY KEY, body text);
INSERT INTO docs VALUES (1, 'Running shoes for runners'), (2, 'Walking boots');
CREATE INDEX docs_idx ON docs USING chdb (body);
-- The storage holds the parts of the store table, each file under a key
-- libchdb chose below the generation's prefix, and plain_rewritable's
-- directory entries that name those keys. The keys are random, so the files
-- are shown by name; every blob was committed by the worker just now.
SELECT DISTINCT regexp_replace(key, '^g\d+/[a-z]+/', '<key>/') AS file
  FROM chdb_search_blobs('docs_idx')
 WHERE key ~ '^g\d+/[a-z]+/(checksums|columns|count|format_version)\.txt$'
 ORDER BY 1;
           file           
--------------------------
 <key>/checksums.txt
 <key>/columns.txt
 <key>/count.txt
 <key>/format_version.txt
(4 rows)

SELECT count(*) FILTER (WHERE key ~ '^g\d+/__meta/[a-z]+/prefix\.path$') > 0 AS has_directory_entries,
       sum(size) > 0 AS has_bytes,
       bool_and(mtime BETWEEN now() - interval '1 hour' AND now() + interval '1 hour') AS committed_now
  FROM chdb_search_blobs('docs_idx');
 has_directory_entries | has_bytes | committed_now 
-----------------------+-----------+---------------
 t                     | t         | t
(1 row)

-- A flush adds a part: its files appear under a new key.
SELECT count(DISTINCT split_part(key, '/', 2)) FILTER (WHERE key ~ '/count\.txt$') AS parts
  FROM chdb_search_blobs('docs_idx') \gset
INSERT INTO docs VALUES (3, 'Hiking boots');
SELECT count(DISTINCT split_part(key, '/', 2)) FILTER (WHERE key ~ '/count\.txt$') - :parts AS parts_added
  FROM chdb_search_blobs('docs_idx');
 parts_added 
-------------
           1
(1 row)

SET enable_seqscan = off;
SELECT id FROM docs WHERE body @@@ 'boots' ORDER BY id;
 id 
----
  2
  3
(2 rows)

RESET enable_seqscan;
-- Each index has a storage of its own, in its own relation's pages; a
-- rebuild writes its new generation into a new relation, under a prefix
-- of its own, and the old relation's blobs went with it: the listing shows
-- one generation before and after, a different one, and VACUUM's drop of
-- the old table finds nothing left to remove.
CREATE INDEX docs_idx2 ON docs USING chdb (body);
SELECT count(*) > 0 AS second_storage FROM chdb_search_blobs('docs_idx2');
 second_storage 
----------------
 t
(1 row)

DROP INDEX docs_idx2;
SELECT min(split_part(key, '/', 1)) AS generation,
       count(DISTINCT split_part(key, '/', 1)) AS generations
  FROM chdb_search_blobs('docs_idx') \gset
REINDEX INDEX docs_idx;
SELECT min(split_part(key, '/', 1)) <> :'generation' AS rebuilt_into_new_generation,
       count(DISTINCT split_part(key, '/', 1)) = :generations AS one_generation
  FROM chdb_search_blobs('docs_idx');
 rebuilt_into_new_generation | one_generation 
-----------------------------+----------------
 t                           | t
(1 row)

SELECT count(DISTINCT split_part(key, '/', 2)) FILTER (WHERE key ~ '/count\.txt$') AS parts
  FROM chdb_search_blobs('docs_idx') \gset
VACUUM docs;
SELECT count(DISTINCT split_part(key, '/', 2)) FILTER (WHERE key ~ '/count\.txt$') = :parts AS parts_kept
  FROM chdb_search_blobs('docs_idx');
 parts_kept 
------------
 t
(1 row)

SET enable_seqscan = off;
SELECT id FROM docs WHERE body @@@ 'boots' ORDER BY id;
 id 
----
  2
  3
(2 rows)

RESET enable_seqscan;
-- Only a chdb index has blobs, and only a role granted EXECUTE may list them.
SELECT chdb_search_blobs('docs_pkey');
ERROR:  "docs_pkey" is not a chdb index
CREATE ROLE search_blobs_nobody;
SET ROLE search_blobs_nobody;
SELECT chdb_search_blobs('docs_idx');
ERROR:  permission denied for function chdb_search_blobs
RESET ROLE;
DROP ROLE search_blobs_nobody;
DROP TABLE docs;
DROP EXTENSION chdb_search;
