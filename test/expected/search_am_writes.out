-- Writes through the chdb index access method. Rows are buffered per
-- transaction and sent to the store at COMMIT, dropped at ROLLBACK and
-- rewound by ROLLBACK TO a savepoint; every INSERT the buffer sends is logged
-- at DEBUG1 with the rows it carries. The output is the same with the worker
-- and with the stub client (see search_am.sql); what reaches the store is
-- checked by search_e2e.
\set VERBOSITY terse
CREATE EXTENSION chdb_search;
SET search_path = public, chdb;
SET chdb_search.mask_oids = on;
CREATE TABLE docs (
    id int PRIMARY KEY,
    body text,
    title text,
    tags text[],
    author text COLLATE "C",
    price numeric(10, 2),
    seen timestamptz,
    flag bool
);
INSERT INTO docs VALUES
    (1, 'Running shoes for runners', 'Shoes', '{sport,shoes}', 'ann', 49.90, '2026-01-02 03:04:05+00', true),
    (2, 'Walking boots', 'Boots', '{outdoor}', 'bob', 89.00, '2026-02-03 00:00:00+00', false);
CREATE INDEX docs_idx ON docs USING chdb (
    body, title, tags text_array_ops, author columnar_ops, price, seen, flag columnar_ops
);
CREATE INDEX docs_title ON docs USING chdb (title);
----------------------------------------------------------------------------
-- Buffered, flushed at COMMIT, dropped at ROLLBACK
----------------------------------------------------------------------------
SET client_min_messages = debug1;
BEGIN;
INSERT INTO docs VALUES (3, 'committed row', 'T', '{a}', 'cy', 1, now(), true);
\echo -- nothing is sent before COMMIT
-- nothing is sent before COMMIT
COMMIT;
DEBUG:  chdb_search select: SELECT count(), max(lsn), (SELECT count() FROM system.tables WHERE database = 'idx_N' AND name = 't_N') FROM idx_N.meta WHERE generation = N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search select: SELECT count(), max(lsn), (SELECT count() FROM system.tables WHERE database = 'idx_N' AND name = 't_N') FROM idx_N.meta WHERE generation = N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- rolled back
-- rolled back
BEGIN;
INSERT INTO docs VALUES (4, 'rolled back row', 'T', '{a}', 'dee', 1, now(), true);
ROLLBACK;
\echo -- savepoints
-- savepoints
BEGIN;
INSERT INTO docs VALUES (5, 'kept', 'T', '{a}', 'eve', 1, now(), true);
SAVEPOINT s1;
INSERT INTO docs VALUES (6, 'dropped by rollback to', 'T', '{a}', 'fay', 1, now(), true);
ROLLBACK TO s1;
SAVEPOINT s2;
INSERT INTO docs VALUES (7, 'released', 'T', '{a}', 'gus', 1, now(), true);
RELEASE s2;
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 2 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 2 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- update and delete
-- update and delete
UPDATE docs SET body = 'changed' WHERE id = 1;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DELETE FROM docs WHERE id = 2;
\echo -- rows with NULLs
-- rows with NULLs
INSERT INTO docs (id) VALUES (8);
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- a statement that fails after the index buffered a row
-- a statement that fails after the index buffered a row
-- (docs_pkey is checked first for each row, so the duplicate fails at the
-- second row, once the first has reached the buffer; the savepoint takes
-- the buffered row with it and the survivor is sent alone.)
BEGIN;
SAVEPOINT s;
INSERT INTO docs (id, body) VALUES (40, 'indexed before the duplicate'), (1, 'duplicate key');
ERROR:  duplicate key value violates unique constraint "docs_pkey"
ROLLBACK TO s;
INSERT INTO docs (id, body) VALUES (41, 'survivor');
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- an AFTER trigger that raises, once every index has buffered the row
-- an AFTER trigger that raises, once every index has buffered the row
CREATE FUNCTION boom() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE 'boom'; END $$;
CREATE TRIGGER boom AFTER INSERT ON docs FOR EACH ROW EXECUTE FUNCTION boom();
INSERT INTO docs (id, body) VALUES (42, 'never flushed');
ERROR:  boom
DROP TRIGGER boom ON docs;
DROP FUNCTION boom();
RESET client_min_messages;
----------------------------------------------------------------------------
-- Nested savepoints: each level rewinds to its own checkpoint
----------------------------------------------------------------------------
SET client_min_messages = debug1;
\echo -- two levels rolled back in turn
-- two levels rolled back in turn
BEGIN;
INSERT INTO docs (id, body) VALUES (20, 'x');
SAVEPOINT a;
INSERT INTO docs (id, body) VALUES (21, 'y');
SAVEPOINT b;
INSERT INTO docs (id, body) VALUES (22, 'z');
ROLLBACK TO b;
ROLLBACK TO a;
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- a level released into one that is then rolled back
-- a level released into one that is then rolled back
BEGIN;
SAVEPOINT a;
SAVEPOINT b;
INSERT INTO docs (id, body) VALUES (15, 'f');
RELEASE b;
SAVEPOINT c;
INSERT INTO docs (id, body) VALUES (16, 'g');
ROLLBACK TO c;
ROLLBACK TO a;
COMMIT;
\echo -- released and rolled back levels mixed
-- released and rolled back levels mixed
BEGIN;
INSERT INTO docs (id, body) VALUES (10, 'a'), (11, 'b');
SAVEPOINT a;
INSERT INTO docs (id, body) VALUES (12, 'c');
SAVEPOINT b;
INSERT INTO docs (id, body) VALUES (13, 'd');
RELEASE b;
ROLLBACK TO a;
SAVEPOINT c;
INSERT INTO docs (id, body) VALUES (14, 'e');
RELEASE c;
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 3 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 3 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- nested PL/pgSQL exception blocks, the inner one rolled back first
-- nested PL/pgSQL exception blocks, the inner one rolled back first
DO $$
BEGIN
    BEGIN
        INSERT INTO docs (id, body) VALUES (30, 'p');
        BEGIN
            INSERT INTO docs (id, body) VALUES (31, 'q');
            RAISE 'y';
        EXCEPTION WHEN OTHERS THEN
            NULL;
        END;
        RAISE 'x';
    EXCEPTION WHEN OTHERS THEN
        NULL;
    END;
END $$;
\echo -- a handler that inserts after the rollback of the block it handles
-- a handler that inserts after the rollback of the block it handles
DO $$
BEGIN
    BEGIN
        INSERT INTO docs (id, body) VALUES (32, 'p');
        RAISE 'x';
    EXCEPTION WHEN OTHERS THEN
        BEGIN
            INSERT INTO docs (id, body) VALUES (33, 'q');
            RAISE 'y';
        EXCEPTION WHEN OTHERS THEN
            INSERT INTO docs (id, body) VALUES (34, 'r');
        END;
    END;
END $$;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
RESET client_min_messages;
----------------------------------------------------------------------------
-- Inside a savepoint rows are staged too; rolling it back excludes them
----------------------------------------------------------------------------
-- Staged rows cannot be rewound, so the transaction id of a rolled-back
-- savepoint is excluded from what the staging table contributes at COMMIT;
-- the rows of enclosing levels that were staged with them stay.
SET chdb_search.flush_threshold = '64kB';
SET client_min_messages = debug1;
BEGIN;
INSERT INTO docs (id, body) VALUES (999, 'kept');
SAVEPOINT s;
INSERT INTO docs (id, body) SELECT 1000 + i, repeat('word ', 250) FROM generate_series(1, 60) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 51 rows
ROLLBACK TO s;
COMMIT;
DEBUG:  chdb_search exec: INSERT INTO idx_N.t_N SELECT * FROM idx_N.t_N_tx_N WHERE xmin NOT IN (N)
DEBUG:  chdb_search exec: DROP TABLE idx_N.t_N_tx_N
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- a released savepoint passes its staged rows to its parent
-- a released savepoint passes its staged rows to its parent
BEGIN;
SAVEPOINT a;
INSERT INTO docs (id, body) SELECT 2000 + i, repeat('word ', 250) FROM generate_series(1, 60) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
SAVEPOINT b;
INSERT INTO docs (id, body) SELECT 3000 + i, repeat('word ', 250) FROM generate_series(1, 60) i;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
RELEASE b;
ROLLBACK TO a;
INSERT INTO docs (id, body) VALUES (3999, 'kept');
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.t_N SELECT * FROM idx_N.t_N_tx_N WHERE xmin NOT IN (N, N)
DEBUG:  chdb_search exec: DROP TABLE idx_N.t_N_tx_N
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 1 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- a PL/pgSQL block that completes keeps its rows for COMMIT
-- a PL/pgSQL block that completes keeps its rows for COMMIT
DO $$
BEGIN
    INSERT INTO docs (id, body) SELECT 4000 + i, repeat('word ', 250) FROM generate_series(1, 60) i;
EXCEPTION WHEN OTHERS THEN
    NULL;
END $$;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 10 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.t_N SELECT * FROM idx_N.t_N_tx_N
DEBUG:  chdb_search exec: DROP TABLE idx_N.t_N_tx_N
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 60 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
RESET client_min_messages;
RESET chdb_search.flush_threshold;
----------------------------------------------------------------------------
-- Staging: past the threshold a transaction's rows go to <table>_tx_<xid>
----------------------------------------------------------------------------
SET chdb_search.flush_threshold = '64kB';
SET client_min_messages = debug1;
BEGIN;
INSERT INTO docs (id, body) SELECT 10000 + i, repeat('word ', 250) FROM generate_series(1, 120) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
INSERT INTO docs (id, body) VALUES (11000, 'tail');
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 21 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.t_N SELECT * FROM idx_N.t_N_tx_N
DEBUG:  chdb_search exec: DROP TABLE idx_N.t_N_tx_N
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 121 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- a rollback drops the staging table, once
-- a rollback drops the staging table, once
BEGIN;
INSERT INTO docs (id, body) SELECT 12000 + i, repeat('word ', 250) FROM generate_series(1, 120) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
ROLLBACK;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
\echo -- staged rows survive a savepoint rolled back after them
-- staged rows survive a savepoint rolled back after them
BEGIN;
INSERT INTO docs (id, body) SELECT 13000 + i, repeat('word ', 250) FROM generate_series(1, 120) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 50 rows
SAVEPOINT s;
INSERT INTO docs (id, body) VALUES (14000, 'sp');
ROLLBACK TO s;
COMMIT;
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 20 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.t_N SELECT * FROM idx_N.t_N_tx_N
DEBUG:  chdb_search exec: DROP TABLE idx_N.t_N_tx_N
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "title") -- 120 rows
DEBUG:  chdb_search exec: INSERT INTO idx_N.meta (generation, lsn) VALUES (N, N)
\echo -- two indexes over the threshold: one staging table each
-- two indexes over the threshold: one staging table each
BEGIN;
INSERT INTO docs (id, body, title)
SELECT 15000 + i, repeat('word ', 250), repeat('title ', 200) FROM generate_series(1, 120) i;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 27 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 27 rows
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N_tx_N AS idx_N.t_N
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "title") -- 54 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 27 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "body", "title", "tags", "author", "price", "seen", "flag") -- 27 rows
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N_tx_N (ctid, xmin, "title") -- 54 rows
ROLLBACK;
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
RESET client_min_messages;
RESET chdb_search.flush_threshold;
----------------------------------------------------------------------------
-- VACUUM: what it deletes depends on the store's rows (see search_e2e); it
-- also looks for tables of other generations and of finished transactions
----------------------------------------------------------------------------
VACUUM docs;
-- (Nothing is dead now, so only the sweep's statements show.)
SET client_min_messages = debug1;
VACUUM docs;
DEBUG:  chdb_search select: SELECT name FROM system.tables WHERE database = 'idx_N' AND name LIKE 't\\_%'
DEBUG:  chdb_search select: SELECT name FROM system.tables WHERE database = 'idx_N' AND name LIKE 't\\_%'
RESET client_min_messages;
DROP TABLE docs;
DROP EXTENSION chdb_search;
-- The worker stays connected to the database, which could not be dropped for
-- the next run, so stop it. There is none with the stub client.
DO $$
BEGIN
    PERFORM pg_terminate_backend(pid, 10000)
       FROM pg_stat_activity
      WHERE backend_type = 'chdb_search worker' AND datname = current_database();
END $$;
