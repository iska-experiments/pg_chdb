-- The query language of chdb indexes: the pattern operators, the chdb.query
-- type with its builders, and the statements they make the access method
-- generate, logged at DEBUG1. The output is the same with the worker and
-- with the stub client (see search_am.sql): the rows a scan returns are
-- discarded here and checked by search_query_e2e.
\set VERBOSITY terse
CREATE EXTENSION chdb_search;
SET search_path = public, chdb;
SET chdb_search.mask_oids = on;
-- The index access method's own scans are under test: the custom scan,
-- which search_planner shows taking the same searches, is kept out of the
-- plans.
SET chdb_search.enable_custom_scan = off;
----------------------------------------------------------------------------
-- Regex and wildcard: the Postgres fallback of the default preprocessor
----------------------------------------------------------------------------
-- The text is lowercased and the pattern matched without regard to case.
SELECT 'Running shoes' @@/ 'run+ing', 'Running shoes' @@/ '^RUN', 'Running shoes' @@/ 'shoes$',
       'Running shoes' @@/ 'r.nning sh', 'Running shoes' @@/ 'boots', 'ÉCOLE' @@/ 'école';
 ?column? | ?column? | ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------+----------+----------
 t        | t        | t        | t        | f        | t
(1 row)

SELECT chdb.regex('a b', '\Wb'), chdb.regex('ab', 'a\Wb'), chdb.regex('x', '');
 regex | regex | regex 
-------+-------+-------
 t     | f     | t
(1 row)

SELECT 'x' @@/ '(';
ERROR:  invalid regular expression: parentheses () not balanced
SELECT 'Running shoes' @@% 'run%', 'Running shoes' @@% '%SHOES', 'Running shoes' @@% 'run_ing%',
       'Running shoes' @@% 'run%g', 'Running shoes' @@% 'shoes', 'Running shoes' @@% '%';
 ?column? | ?column? | ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------+----------+----------
 t        | t        | t        | f        | f        | t
(1 row)

-- A backslash escapes %, _ and itself; _ is one character, not one byte.
SELECT chdb.wildcard('50% off', '50\% %'), chdb.wildcard('50x off', '50\% %'),
       chdb.wildcard('a_b', 'a\_b'), chdb.wildcard('axb', 'a\_b'), chdb.wildcard('a\b', 'a\\b'),
       chdb.wildcard('é', '_'), chdb.wildcard('é', '__'), chdb.wildcard('', '');
 wildcard | wildcard | wildcard | wildcard | wildcard | wildcard | wildcard | wildcard 
----------+----------+----------+----------+----------+----------+----------+----------
 t        | f        | t        | f        | t        | t        | f        | t
(1 row)

SELECT NULL::text @@/ 'x', 'x' @@% NULL;
 ?column? | ?column? 
----------+----------
          | 
(1 row)

----------------------------------------------------------------------------
-- chdb.query: the builders and the readable form
----------------------------------------------------------------------------
SELECT chdb.match('running shoes'), chdb.match_all('running shoes'), chdb.term('shoes'),
       chdb.phrase('running shoes'), chdb.phrase('running shoes', 2), chdb.regex('run+'),
       chdb.wildcard('run%');
         match          |         match_all          |     term      |         phrase          |           phrase           |     regex     |     wildcard     
------------------------+----------------------------+---------------+-------------------------+----------------------------+---------------+------------------
 match('running shoes') | match_all('running shoes') | term('shoes') | phrase('running shoes') | phrase('running shoes', 2) | regex('run+') | wildcard('run%')
(1 row)

-- && and || flatten a chain into one group; ! negates; boost carries a weight.
SELECT chdb.term('a') && chdb.term('b') && chdb.term('c'),
       chdb.term('a') || (chdb.term('b') || chdb.term('c')),
       (chdb.term('a') && chdb.term('b')) || chdb.term('c'),
       !chdb.term('a'), !(!chdb.term('a')),
       chdb.boost(chdb.term('a'), 2.5), chdb.boost(chdb.match('a b') && chdb.term('c'), 0.5);
               ?column?               |              ?column?               |                 ?column?                 |    ?column?    |      ?column?       |         boost         |                  boost                   
--------------------------------------+-------------------------------------+------------------------------------------+----------------+---------------------+-----------------------+------------------------------------------
 and(term('a'), term('b'), term('c')) | or(term('a'), term('b'), term('c')) | or(and(term('a'), term('b')), term('c')) | not(term('a')) | not(not(term('a'))) | boost(term('a'), 2.5) | boost(and(match('a b'), term('c')), 0.5)
(1 row)

SELECT chdb.all_of(chdb.term('a'), chdb.term('b') && chdb.term('c')),
       chdb.any_of(chdb.term('a')), chdb.none_of(chdb.phrase('a b', 1)),
       chdb.in_column(chdb.term('a') || chdb.in_column(chdb.term('b'), 'other'), 'title');
                all_of                |  any_of   |        none_of        |                            in_column                             
--------------------------------------+-----------+-----------------------+------------------------------------------------------------------
 and(term('a'), term('b'), term('c')) | term('a') | not(phrase('a b', 1)) | or(in_column(term('a'), 'title'), in_column(term('b'), 'other'))
(1 row)

-- A needle keeps its quotes, backslashes and newlines through the form.
SELECT chdb.term(E'it''s a \\ back\nslash');
         term         
----------------------
 term('it''s a \ back+
 slash')
(1 row)

SELECT chdb.term(E'it''s a \\ back\nslash')::text::chdb.query::text = chdb.term(E'it''s a \\ back\nslash')::text;
 ?column? 
----------
 t
(1 row)

-- The form reads back, whitespace and all.
SELECT 'and( match_all( ''running shoes'' ) ,not(phrase(''on sale'',1)), boost(term(''new''), 2))'::chdb.query;
                                       query                                       
-----------------------------------------------------------------------------------
 and(match_all('running shoes'), not(phrase('on sale', 1)), boost(term('new'), 2))
(1 row)

SELECT 'in_column(or(term(''a''), wildcard(''b%'')), ''title'')'::chdb.query;
                                 query                                 
-----------------------------------------------------------------------
 or(in_column(term('a'), 'title'), in_column(wildcard('b%'), 'title'))
(1 row)

-- Rejected forms and arguments.
SELECT 'bogus(''x'')'::chdb.query;
ERROR:  invalid input syntax for type chdb.query: "bogus('x')" at character 8
SELECT 'term(''x'::chdb.query;
ERROR:  invalid input syntax for type chdb.query: "term('x" at character 8
SELECT 'term(''x'') extra'::chdb.query;
ERROR:  invalid input syntax for type chdb.query: "term('x') extra" at character 8
SELECT 'boost(term(''x''), two)'::chdb.query;
ERROR:  invalid input syntax for type real: "two" at character 8
SELECT 'not(term(''x''), term(''y''))'::chdb.query;
ERROR:  invalid input syntax for type chdb.query: "not(term('x'), term('y'))" at character 8
SELECT 'phrase(''x'', -1)'::chdb.query;
ERROR:  a phrase's slop cannot be negative at character 8
SELECT chdb.phrase('x', -1);
ERROR:  a phrase's slop cannot be negative
SELECT chdb.all_of(VARIADIC ARRAY[]::chdb.query[]);
ERROR:  a chdb.query combination needs at least one query
SELECT chdb.any_of(chdb.term('a'), NULL);
ERROR:  a chdb.query combination cannot include a null query
----------------------------------------------------------------------------
-- The Postgres fallback evaluates the tree with the fallback of each leaf
----------------------------------------------------------------------------
SELECT 'Running shoes for runners' @@@ chdb.match('boots shoes'),
       'Running shoes for runners' @@@ chdb.match_all('boots shoes'),
       'Running shoes for runners' @@@ (chdb.term('shoes') && !chdb.term('boots')),
       'Running shoes for runners' @@@ (chdb.term('boots') || chdb.phrase('for runners')),
       'Running shoes for runners' @@@ chdb.boost(chdb.regex('^run') && chdb.wildcard('%runners'), 3),
       'Running shoes for runners' @@@ !chdb.match('running'),
       NULL::text @@@ chdb.term('x');
 ?column? | ?column? | ?column? | ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------+----------+----------+----------
 t        | f        | t        | t        | t        | f        | 
(1 row)

SELECT ARRAY['Sport', 'shoes'] @@@ chdb.any_of(chdb.term('SHOES'), chdb.term('boots')),
       ARRAY['Sport', 'shoes'] @@@ (chdb.match('sport') && !chdb.match_all('trail'));
 ?column? | ?column? 
----------+----------
 t        | t
(1 row)

-- A NULL array reads as the empty array the index stores for it.
SELECT NULL::text[] @@@ chdb.term('x'), NULL::text[] @@@ !chdb.term('x'), '{}'::text[] @@@ !chdb.term('x'),
       NULL::text[] @@@ NULL;
 ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------
 f        | t        | t        | 
(1 row)

SELECT ARRAY['a'] @@@ chdb.phrase('a b');
ERROR:  chdb indexes do not search text[] columns for phrases
SELECT ARRAY['a'] @@@ chdb.regex('a');
ERROR:  chdb indexes do not search text[] columns for patterns
SELECT 'x' @@@ chdb.in_column(chdb.term('x'), 'title');
ERROR:  a chdb.query naming a column is evaluated through a chdb index only
SELECT 'x' @@@ chdb.term('two words');
ERROR:  has_token needs a needle that is a single token
-- Phrase slop: the needle's tokens in order, with at most slop other tokens
-- between the first and the last. In 'a running b c shoes' two tokens part
-- running from shoes, so slop 1 misses by one and slop 2 matches; order is
-- never relaxed; one token matches wherever it is; none match nothing.
SELECT 'a running b c shoes' @@@ chdb.phrase('running shoes', 1),
       'a running b c shoes' @@@ chdb.phrase('running shoes', 2),
       'a running b c shoes' @@@ chdb.phrase('shoes running', 9),
       'a running b c shoes' @@@ chdb.phrase('a c shoes', 1),
       'a running b c shoes' @@@ chdb.phrase('a c shoes', 2),
       'a running b c shoes' @@@ chdb.phrase('RUNNING', 0),
       'a running b c shoes' @@@ chdb.phrase('', 3);
 ?column? | ?column? | ?column? | ?column? | ?column? | ?column? | ?column? 
----------+----------+----------+----------+----------+----------+----------
 f        | t        | f        | f        | t        | t        | f
(1 row)

-- The span starts at every occurrence of the first token and takes the
-- nearest next one of each other token, so the shortest span decides.
SELECT 'x b x x b c' @@@ chdb.phrase('b c'), 'b x x b c' @@@ chdb.phrase('x c', 1),
       'b x x b c' @@@ chdb.phrase('x c', 0);
 ?column? | ?column? | ?column? 
----------+----------+----------
 t        | t        | f
(1 row)

----------------------------------------------------------------------------
-- The operator class carries the new strategies
----------------------------------------------------------------------------
SELECT amopstrategy, amopopr::regoperator
  FROM pg_amop
 WHERE amopfamily = (SELECT oid FROM pg_opfamily WHERE opfname = 'text_ops'
                        AND opfmethod = (SELECT oid FROM pg_am WHERE amname = 'chdb'))
 ORDER BY amopstrategy;
 amopstrategy |     amopopr     
--------------+-----------------
            1 | @@@(text,text)
            2 | @@?(text,text)
            3 | @@=(text,text)
            4 | @@~(text,text)
            5 | @@@(text,query)
            6 | @@/(text,text)
            7 | @@%(text,text)
(7 rows)

SELECT opcname, amvalidate(oid)
  FROM pg_opclass
 WHERE opcmethod = (SELECT oid FROM pg_am WHERE amname = 'chdb')
 ORDER BY opcname;
    opcname     | amvalidate 
----------------+------------
 columnar_ops   | t
 text_array_ops | t
 text_ops       | t
(3 rows)

----------------------------------------------------------------------------
-- The statements scans generate: the pattern follows the preprocessor
----------------------------------------------------------------------------
CREATE TABLE docs (
    id int PRIMARY KEY, body text, html text, plain text, raw text, ng text, sep text, tags text[]
);
INSERT INTO docs VALUES
    (1, 'Running shoes', '<b>Bold</b>', 'Plain', 'Hyphen-ated', 'Grams', 'a b,c', '{sport}');
CREATE INDEX docs_idx ON docs USING chdb (
    body,
    html text_ops (preprocessor = 'extractTextFromHTML'),
    plain text_ops (preprocessor = 'none'),
    raw text_ops (raw_preprocessor = 'lowerUTF8(replaceAll(raw, ''-'', '' ''))'),
    ng text_ops (tokenizer = 'ngrams', ngram_size = 2),
    sep text_ops (tokenizer = 'splitByString', tokenizer_arg = ' ,'),
    tags text_array_ops
);
SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT id FROM docs WHERE body @@/ 'run+ing' AND body @@% 'Run%';
                               QUERY PLAN                               
------------------------------------------------------------------------
 Index Scan using docs_idx on docs
   Index Cond: ((body @@/ 'run+ing'::text) AND (body @@% 'Run%'::text))
(2 rows)

SET client_min_messages = debug1;
\o /dev/null
SELECT id FROM docs WHERE body @@/ 'run+ing';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE match(lowerUTF8("body"), '(?i)run+ing')
SELECT id FROM docs WHERE body @@% 'Run%';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (lowerUTF8("body") LIKE lowerUTF8('Run%'))
SELECT id FROM docs WHERE html @@/ 'bold' AND plain @@% 'Pla%';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE match(extractTextFromHTML("html"), 'bold') AND ("plain" LIKE 'Pla%')
SELECT id FROM docs WHERE raw @@/ 'hyphen ated' AND raw @@% 'hyphen%';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE match(lowerUTF8(replaceAll(raw, '-', ' ')), '(?i)hyphen ated') AND (lowerUTF8(replaceAll(raw, '-', ' ')) LIKE (SELECT lowerUTF8(replaceAll(raw, '-', ' ')) FROM (SELECT 'hyphen%' AS "raw")))
SELECT id FROM docs WHERE body @@/ E'it''s \\d+' AND body @@% E'50\\% ''off''%';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE match(lowerUTF8("body"), '(?i)it\'s \\d+') AND (lowerUTF8("body") LIKE lowerUTF8('50\\% \'off\'%'))
\o
RESET client_min_messages;
-- An array column has no pattern operators.
SELECT id FROM docs WHERE tags @@/ 'x';
ERROR:  operator does not exist: text[] @@/ unknown at character 32
SELECT id FROM docs WHERE tags @@% 'x';
ERROR:  operator does not exist: text[] @@% unknown at character 32
----------------------------------------------------------------------------
-- A chdb.query is one term of the WHERE, with each leaf as its operator
-- renders it; the planner folds the builders to a constant
----------------------------------------------------------------------------
EXPLAIN (COSTS OFF) SELECT id FROM docs WHERE body @@@ (chdb.match('running') && !chdb.term('boots'));
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Index Scan using docs_idx on docs
   Index Cond: (body @@@ 'and(match(''running''), not(term(''boots'')))'::query)
(2 rows)

SET client_min_messages = debug1;
\o /dev/null
SELECT id FROM docs WHERE body @@@ chdb.match('running shoes');
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE hasAnyTokens("body", 'running shoes')
SELECT id FROM docs WHERE body @@@ (chdb.match_all('running shoes') && !chdb.term('boots'));
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE ("body" IS NOT NULL AND (hasAllTokens("body", 'running shoes') AND NOT hasToken("body", 'boots')))
SELECT id FROM docs WHERE body @@@ (chdb.term('a') || chdb.phrase('b c') || chdb.boost(chdb.regex('d+'), 2));
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasToken("body", 'a') OR hasPhrase("body", 'b c') OR match(lowerUTF8("body"), '(?i)d+'))
-- A text column with a NOT in its tree is guarded against NULL, which the
-- strict operator never matches while ClickHouse's NOT false would.
SELECT id FROM docs WHERE body @@@ !(chdb.wildcard('a%') && chdb.term('b')) AND body @@= 'c';
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE ("body" IS NOT NULL AND NOT ((lowerUTF8("body") LIKE lowerUTF8('a%')) AND hasToken("body", 'b'))) AND hasToken("body", 'c')
SELECT id FROM docs WHERE tags @@@ !chdb.term('sport');
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE NOT hasAllTokens("tags", 'sport')
SELECT id FROM docs WHERE tags @@@ chdb.any_of(chdb.term('sport'), chdb.match_all('trail'));
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasAllTokens("tags", 'sport') OR hasAllTokens("tags", 'trail'))
-- A leaf naming another column of the index searches that column.
SELECT id FROM docs WHERE body @@@ (chdb.term('a') && chdb.in_column(chdb.term('b'), 'html') && chdb.in_column(chdb.match('c'), 'tags'));
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasToken("body", 'a') AND hasToken("html", 'b') AND hasAnyTokens("tags", 'c'))
\o
RESET client_min_messages;
-- A phrase with slop is hasAllTokens, which the index answers, and a check
-- of the token positions, with the column and the needle tokenized as the
-- index tokenizes them: tokenizer, arguments and preprocessor.
SET client_min_messages = debug1;
\o /dev/null
SELECT id FROM docs WHERE body @@@ chdb.phrase('running shoes', 2);
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasAllTokens("body", 'running shoes') AND arrayExists(d -> d >= 0 AND d + 1 - length(tokens(lowerUTF8('running shoes'), 'splitByNonAlpha')) <= 2, arrayMap(i -> toInt64(arrayFold((acc, t) -> if(acc = 0, toUInt32(0), arrayFirst(p -> p > acc, arrayFilter((p, x) -> x = t, arrayEnumerate(tokens(lowerUTF8("body"), 'splitByNonAlpha')), tokens(lowerUTF8("body"), 'splitByNonAlpha')))), arraySlice(tokens(lowerUTF8('running shoes'), 'splitByNonAlpha'), 2), i)) - toInt64(i), arrayFilter((p, x) -> x = tokens(lowerUTF8('running shoes'), 'splitByNonAlpha')[1], arrayEnumerate(tokens(lowerUTF8("body"), 'splitByNonAlpha')), tokens(lowerUTF8("body"), 'splitByNonAlpha')))))
SELECT id FROM docs WHERE ng @@@ chdb.phrase('gr am', 1) AND sep @@@ chdb.phrase('a c', 1);
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasAllTokens("ng", 'gr am') AND arrayExists(d -> d >= 0 AND d + 1 - length(tokens(lowerUTF8('gr am'), 'ngrams', 2)) <= 1, arrayMap(i -> toInt64(arrayFold((acc, t) -> if(acc = 0, toUInt32(0), arrayFirst(p -> p > acc, arrayFilter((p, x) -> x = t, arrayEnumerate(tokens(lowerUTF8("ng"), 'ngrams', 2)), tokens(lowerUTF8("ng"), 'ngrams', 2)))), arraySlice(tokens(lowerUTF8('gr am'), 'ngrams', 2), 2), i)) - toInt64(i), arrayFilter((p, x) -> x = tokens(lowerUTF8('gr am'), 'ngrams', 2)[1], arrayEnumerate(tokens(lowerUTF8("ng"), 'ngrams', 2)), tokens(lowerUTF8("ng"), 'ngrams', 2))))) AND (hasAllTokens("sep", 'a c') AND arrayExists(d -> d >= 0 AND d + 1 - length(tokens(lowerUTF8('a c'), 'splitByString', [' ', ','])) <= 1, arrayMap(i -> toInt64(arrayFold((acc, t) -> if(acc = 0, toUInt32(0), arrayFirst(p -> p > acc, arrayFilter((p, x) -> x = t, arrayEnumerate(tokens(lowerUTF8("sep"), 'splitByString', [' ', ','])), tokens(lowerUTF8("sep"), 'splitByString', [' ', ','])))), arraySlice(tokens(lowerUTF8('a c'), 'splitByString', [' ', ',']), 2), i)) - toInt64(i), arrayFilter((p, x) -> x = tokens(lowerUTF8('a c'), 'splitByString', [' ', ','])[1], arrayEnumerate(tokens(lowerUTF8("sep"), 'splitByString', [' ', ','])), tokens(lowerUTF8("sep"), 'splitByString', [' ', ','])))))
SELECT id FROM docs WHERE plain @@@ chdb.phrase('Plain text', 1);
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasAllTokens("plain", 'Plain text') AND arrayExists(d -> d >= 0 AND d + 1 - length(tokens('Plain text', 'splitByNonAlpha')) <= 1, arrayMap(i -> toInt64(arrayFold((acc, t) -> if(acc = 0, toUInt32(0), arrayFirst(p -> p > acc, arrayFilter((p, x) -> x = t, arrayEnumerate(tokens("plain", 'splitByNonAlpha')), tokens("plain", 'splitByNonAlpha')))), arraySlice(tokens('Plain text', 'splitByNonAlpha'), 2), i)) - toInt64(i), arrayFilter((p, x) -> x = tokens('Plain text', 'splitByNonAlpha')[1], arrayEnumerate(tokens("plain", 'splitByNonAlpha')), tokens("plain", 'splitByNonAlpha')))))
SELECT id FROM docs WHERE raw @@@ chdb.phrase('hyphen ated', 1);
DEBUG:  chdb_search select: SELECT ctid FROM idx_N.t_N WHERE (hasAllTokens("raw", 'hyphen ated') AND arrayExists(d -> d >= 0 AND d + 1 - length(tokens((SELECT lowerUTF8(replaceAll(raw, '-', ' ')) FROM (SELECT 'hyphen ated' AS "raw")), 'splitByNonAlpha')) <= 1, arrayMap(i -> toInt64(arrayFold((acc, t) -> if(acc = 0, toUInt32(0), arrayFirst(p -> p > acc, arrayFilter((p, x) -> x = t, arrayEnumerate(tokens(lowerUTF8(replaceAll(raw, '-', ' ')), 'splitByNonAlpha')), tokens(lowerUTF8(replaceAll(raw, '-', ' ')), 'splitByNonAlpha')))), arraySlice(tokens((SELECT lowerUTF8(replaceAll(raw, '-', ' ')) FROM (SELECT 'hyphen ated' AS "raw")), 'splitByNonAlpha'), 2), i)) - toInt64(i), arrayFilter((p, x) -> x = tokens((SELECT lowerUTF8(replaceAll(raw, '-', ' ')) FROM (SELECT 'hyphen ated' AS "raw")), 'splitByNonAlpha')[1], arrayEnumerate(tokens(lowerUTF8(replaceAll(raw, '-', ' ')), 'splitByNonAlpha')), tokens(lowerUTF8(replaceAll(raw, '-', ' ')), 'splitByNonAlpha')))))
\o
RESET client_min_messages;
SELECT id FROM docs WHERE body @@@ chdb.in_column(chdb.term('a'), 'nope');
ERROR:  chdb index has no column named "nope"
SELECT id FROM docs WHERE body @@@ chdb.in_column(chdb.term('a'), 'id');
ERROR:  chdb index has no column named "id"
SELECT id FROM docs WHERE tags @@@ chdb.phrase('a b');
ERROR:  chdb indexes do not search text[] columns for phrases
RESET enable_seqscan;
DROP TABLE docs;
DROP EXTENSION chdb_search;
-- The worker stays connected to the database, which could not be dropped for
-- the next run, so stop it. There is none with the stub client.
DO $$
BEGIN
    PERFORM pg_terminate_backend(pid, 10000)
       FROM pg_stat_activity
      WHERE backend_type = 'chdb_search worker' AND datname = current_database();
END $$;
