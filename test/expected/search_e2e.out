(1 row)

-- So is a staging table whose transaction is over, as a crashed backend
-- leaves it (xid 3 is the first ever assigned).
SELECT chdb_search_exec(format('CREATE TABLE %s_tx_3 AS %s', :'tbl2', :'tbl2'));
 chdb_search_exec 
------------------
 
(1 row)

SELECT pg_temp.tables(:idx);
 tables 
--------
      2
(1 row)

SET client_min_messages = debug1;
VACUUM prod;
DEBUG:  chdb_search select: SELECT name FROM system.tables WHERE database = 'idx_N' AND name LIKE 't\\_%'
DEBUG:  chdb_search exec: DROP TABLE IF EXISTS idx_N.t_N_tx_N
SET client_min_messages = warning;
SELECT pg_temp.tables(:idx);
