-- chdb.score() through the custom scan with the stub worker client (make
-- CHDB_SEARCH_STUB=1): the plan and the statements the scan sends for the
-- weights, seen without a worker. The stub answers tokens() with
-- chdb_search_stub.tokens, a count() with the number of its ctids or the
-- frequency chdb_search_stub.frequencies gives a token, and the scan's
-- statement with the ctids, each scored with its own value. Runs only with
-- the stub (see the Makefile); search_score covers the worker.
\set VERBOSITY terse
CREATE EXTENSION chdb_search;
SET search_path = public, chdb;
SET chdb_search.mask_oids = on;
CREATE TABLE docs (id int PRIMARY KEY, body text, price numeric(10, 2));
INSERT INTO docs VALUES
    (1, 'Running shoes', 49.90), (2, 'Walking boots', 89.00), (3, 'Trail shoes', 120.00);
CREATE INDEX docs_idx ON docs USING chdb (body, price);
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET chdb_search_stub.ctids = '1,2,3';
SET chdb_search_stub.tokens = 'running,shoes';
SET chdb_search_stub.frequencies = 'running:1,shoes:2';
----------------------------------------------------------------------------
-- The plan: the weights come from one tokens() and one count() per token
-- beside the table's count, asked once for the statement
----------------------------------------------------------------------------
SET client_min_messages = debug1;
EXPLAIN (COSTS OFF)
SELECT id, chdb.score(id) FROM docs WHERE body @@@ 'Running Shoes' ORDER BY chdb.score(id) DESC LIMIT 2;
DEBUG:  chdb_search select: SELECT tokens(lowerUTF8('Running Shoes'), 'splitByNonAlpha')
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['running'])
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['shoes'])
                                                                                                                                                                        QUERY PLAN                                                                                                                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (chdb_search) on docs
         Pushed Cond: (body @@@ 'Running Shoes'::text)
         Pushed Score: score(id)
         Pushed Limit: 2
         ClickHouse: SELECT ctid, xmin, toFloat32(log(2.5 / 1.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['running'], 'splitByNonAlpha'), 0) + log(1.5 / 2.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['shoes'], 'splitByNonAlpha'), 0)) AS _score FROM idx_N.t_N WHERE hasAllTokens("body", 'Running Shoes') ORDER BY _score DESC, ctid LIMIT 2
(6 rows)

-- A chdb.query is scored by its token leaves, each weighed by the boosts
-- above it: one tokens() for the match below, none for the NOT and the
-- pattern, which weigh nothing.
EXPLAIN (COSTS OFF)
SELECT id FROM docs WHERE body @@@ (chdb.boost(chdb.match('Running Shoes'), 2) && !chdb.term('boots') && chdb.regex('sho'))
 ORDER BY chdb.score(id) DESC LIMIT 2;
DEBUG:  chdb_search select: SELECT tokens(lowerUTF8('Running Shoes'), 'splitByNonAlpha')
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['running'])
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['shoes'])
                                                                                                                                                                                                                               QUERY PLAN                                                                                                                                                                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (chdb_search) on docs
         Pushed Cond: (body @@@ 'and(boost(match(''Running Shoes''), 2), not(term(''boots'')), regex(''sho''))'::query)
         Pushed Score: score(id)
         Pushed Limit: 2
         ClickHouse: SELECT ctid, xmin, toFloat32(2 * log(2.5 / 1.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['running'], 'splitByNonAlpha'), 0) + 2 * log(1.5 / 2.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['shoes'], 'splitByNonAlpha'), 0)) AS _score FROM idx_N.t_N WHERE ("body" IS NOT NULL AND (hasAnyTokens("body", 'Running Shoes') AND NOT hasToken("body", 'boots') AND match(lowerUTF8("body"), '(?i)sho'))) ORDER BY _score DESC, ctid LIMIT 2
(6 rows)

RESET client_min_messages;
EXPLAIN (VERBOSE, COSTS OFF)
SELECT id, chdb.score(id) FROM docs WHERE body @@@ 'Running Shoes' AND price < 100 AND id > 1;
                                                                                                                                                                      QUERY PLAN                                                                                                                                                                       
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (chdb_search) on public.docs
   Output: id, (score(id))
   Filter: (docs.id > 1)
   Pushed Cond: (docs.body @@@ 'Running Shoes'::text), (docs.price < '100'::numeric)
   Pushed Score: score(docs.id)
   ClickHouse: SELECT ctid, xmin, toFloat32(log(2.5 / 1.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['running'], 'splitByNonAlpha'), 0) + log(1.5 / 2.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['shoes'], 'splitByNonAlpha'), 0)) AS _score FROM idx_N.t_N WHERE hasAllTokens("body", 'Running Shoes') AND "price" < toDecimal256('100', 0)
(6 rows)

----------------------------------------------------------------------------
-- The rows the store returns come with their scores
----------------------------------------------------------------------------
SELECT id, chdb.score(id) FROM docs WHERE body @@@ 'x' ORDER BY chdb.score(id) DESC LIMIT 2;
 id | score 
----+-------
  1 |     1
  2 |     2
(2 rows)

SELECT id, chdb.score(id) FROM docs WHERE body @@@ 'x' AND chdb.score(id) > 1 ORDER BY id;
 id | score 
----+-------
  2 |     2
  3 |     3
(2 rows)

-- A rescan with another needle asks the counts again only for new tokens:
-- the stub makes the same tokens of every needle, so none is asked twice.
SET client_min_messages = debug1;
SELECT q, d.id, d.score FROM (VALUES ('boots'), ('running')) v(q), LATERAL (SELECT id, chdb.score(id) FROM docs WHERE body @@@ v.q OFFSET 0) d ORDER BY 1, 2;
DEBUG:  chdb_search select: SELECT tokens(lowerUTF8('boots'), 'splitByNonAlpha')
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['running'])
DEBUG:  chdb_search select: SELECT count() FROM idx_N.t_N WHERE hasAllTokens("body", ['shoes'])
DEBUG:  chdb_search select: SELECT ctid, xmin, toFloat32(log(2.5 / 1.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['running'], 'splitByNonAlpha'), 0) + log(1.5 / 2.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['shoes'], 'splitByNonAlpha'), 0)) AS _score FROM idx_N.t_N WHERE hasAllTokens("body", 'boots')
DEBUG:  chdb_search select: SELECT tokens(lowerUTF8('running'), 'splitByNonAlpha')
DEBUG:  chdb_search select: SELECT ctid, xmin, toFloat32(log(2.5 / 1.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['running'], 'splitByNonAlpha'), 0) + log(1.5 / 2.5 + 1) * ifNull(hasAllTokens(lowerUTF8("body"), ['shoes'], 'splitByNonAlpha'), 0)) AS _score FROM idx_N.t_N WHERE hasAllTokens("body", 'running')
    q    | id | score 
---------+----+-------
 boots   |  1 |     1
 boots   |  2 |     2
 boots   |  3 |     3
 running |  1 |     1
 running |  2 |     2
 running |  3 |     3
(6 rows)

RESET client_min_messages;
-- Outside a custom scan the function raises.
SELECT chdb.score(id) FROM docs;
ERROR:  chdb.score() needs a chdb index scan
SELECT chdb.score(id) FROM docs WHERE body @@@ 'x' FOR UPDATE;
ERROR:  chdb.score() needs a chdb index scan
DROP TABLE docs;
DROP EXTENSION chdb_search;
