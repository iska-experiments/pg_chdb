-- The SELECT statements the chdb index access method generates for scans,
-- logged at DEBUG1: how search keys, filters and order-by keys are rendered
-- and how literals are quoted. The output is the same with the worker and
-- with the stub client (see search_am.sql): the rows a scan returns are
-- discarded here and checked by search_e2e.
\set VERBOSITY terse
CREATE EXTENSION chdb_search;
SET search_path = public, chdb;
SET chdb_search.mask_oids = on;
-- The index access method's own scans are under test: the custom scan,
-- which has tests of its own, is kept out of the plans.
SET chdb_search.enable_custom_scan = off;
CREATE TABLE docs (
    id int PRIMARY KEY,
    body text,
    title text,
    tags text[],
    author text COLLATE "C",
    price numeric(10, 2),
    seen timestamptz,
    flag bool,
    loc point
);
INSERT INTO docs VALUES
    (1, 'Running shoes for runners', 'Shoes', '{sport,shoes}', 'ann', 49.90, '2026-01-02 03:04:05+00', true, '(1,2)'),
    (2, 'Walking boots', 'Boots', '{outdoor}', 'bob', 89.00, '2026-02-03 00:00:00+00', false, '(3,4)');
CREATE INDEX docs_idx ON docs USING chdb (
    body, title, tags text_array_ops, author columnar_ops, price, seen, flag columnar_ops
);
SET enable_seqscan = off;
----------------------------------------------------------------------------
-- Search keys and filters, with escaping of the search string
----------------------------------------------------------------------------
SET client_min_messages = debug1;
\o /dev/null
SELECT id FROM docs WHERE body @@@ 'running shoes';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE hasAllTokens("body", 'running shoes')
SELECT id FROM docs WHERE body @@? 'it''s a \back\slash';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE hasAnyTokens("body", 'it\'s a \\back\\slash')
SELECT id FROM docs WHERE title @@= 'Shoes' AND tags @@@ 'sport' AND author >= 'a' AND price < 50.50;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE hasToken("title", 'Shoes') AND hasAllTokens("tags", 'sport') AND "author" >= 'a' AND "price" < toDecimal256('50.50', 2)
SELECT id FROM docs WHERE seen > '2026-01-01 00:00:00+00' AND flag = false;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "seen" > fromUnixTimestamp64Micro(1767225600000000, 'UTC') AND "flag" = false
\o
RESET client_min_messages;
-- A NULL search key. Written as a constant it never reaches the scan: the
-- operator is strict, so the planner folds the qual to false. From a generic
-- plan it reaches the scan as a runtime key, which sends no statement and
-- returns no row. (PostgreSQL 19 names the scan the Result replaces, which
-- search_am_scan_1.out expects.)
EXPLAIN (COSTS OFF) SELECT id FROM docs WHERE body @@@ NULL;
        QUERY PLAN        
--------------------------
 Result
   One-Time Filter: false
(2 rows)

PREPARE q(text) AS SELECT id FROM docs WHERE body @@@ $1;
SET plan_cache_mode = force_generic_plan;
EXPLAIN (COSTS OFF) EXECUTE q(NULL);
            QUERY PLAN             
-----------------------------------
 Index Scan using docs_idx on docs
   Index Cond: (body @@@ $1)
(2 rows)

SET client_min_messages = debug1;
EXECUTE q(NULL);
 id 
----
(0 rows)

\o /dev/null
EXECUTE q('shoes');
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE hasAllTokens("body", 'shoes')
\o
RESET client_min_messages;
RESET plan_cache_mode;
DEALLOCATE q;
----------------------------------------------------------------------------
-- Literals: parsed to the column's type, and the constants ClickHouse
-- compares unlike Postgres (NaN, the infinities) become predicates
----------------------------------------------------------------------------
CREATE TABLE types (
    i2 int2, i4 int4, i8 int8, f4 float4, f8 float8, n numeric, d date,
    ts timestamp, u uuid, v varchar(20) COLLATE "C", arr text[]
);
-- (The table's DDL shows the ClickHouse type of every column.)
SET client_min_messages = debug1;
CREATE INDEX types_idx ON types USING chdb (i2, i4, i8, f4, f8, n, d, ts, u, v columnar_ops, arr text_array_ops);
DEBUG:  building index "types_idx" on table "types" serially
DEBUG:  chdb_search exec: CREATE DATABASE IF NOT EXISTS idx_N
DEBUG:  chdb_search exec: CREATE TABLE idx_N.t_N UUID 'N' (ctid UInt64, xmin UInt32, "i2" Nullable(Int16), "i4" Nullable(Int32), "i8" Nullable(Int64), "f4" Nullable(Float32), "f8" Nullable(Float64), "n" Nullable(Decimal256(38)), "d" Nullable(Date32), "ts" Nullable(DateTime64(6, 'UTC')), "u" Nullable(UUID), "v" Nullable(String), "arr" Array(Nullable(String)), INDEX "arr_idx" "arr" TYPE text(tokenizer = array, preprocessor = lowerUTF8("arr"))) ENGINE = MergeTree ORDER BY ctid SETTINGS disk = disk(type = 'callback', storage_name = 'pg_N', key_prefix = 'gN'), enable_block_number_column = 1, enable_block_offset_column = 1
DEBUG:  chdb_search insert: INSERT INTO idx_N.t_N (ctid, xmin, "i2", "i4", "i8", "f4", "f8", "n", "d", "ts", "u", "v", "arr") -- 0 rows
\o /dev/null
SELECT * FROM types WHERE i2 = 1::int2 AND i4 = 2 AND i8 = 3::int8 AND v = 'x' AND d = '2026-01-02';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "i2" = 1 AND "i4" = 2 AND "i8" = 3 AND "d" = toDate32(20455) AND "v" = 'x'
SELECT * FROM types WHERE i2 = 1 AND i8 = 2 AND i4 > 3::int8 AND f4 < 0.5 AND f8 >= 1::real;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "i2" = 1 AND "i4" > 3 AND "i8" = 2 AND "f4" < toFloat64('0.5') AND "f8" >= toFloat32('1')
SELECT * FROM types WHERE u = '00000000-0000-0000-0000-000000000001' AND arr @@= 'x';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "u" = toUUID('00000000-0000-0000-0000-000000000001') AND hasAllTokens("arr", 'x')
SELECT * FROM types WHERE f4 = 0.1::real;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "f4" = toFloat32('0.1')
SELECT * FROM types WHERE f8 = 0.1 AND f4 > 'Infinity'::real;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "f4" > toFloat32('Infinity') AND "f8" = toFloat64('0.1')
SELECT * FROM types WHERE f8 > 1e308;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "f8" > toFloat64('1e+308')
SELECT * FROM types WHERE f8 = 'NaN'::float8;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE isNaN("f8")
SELECT * FROM types WHERE f8 < 'NaN';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE NOT isNaN("f8")
SELECT * FROM types WHERE f8 > 'NaN';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE 0
SELECT * FROM types WHERE f8 <= 'NaN';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "f8" IS NOT NULL
SELECT * FROM types WHERE f8 >= 'NaN' AND f4 = 'NaN'::real;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE isNaN("f4") AND isNaN("f8")
SELECT * FROM types WHERE ts < 'infinity';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "ts" IS NOT NULL
SELECT * FROM types WHERE ts = 'infinity';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE 0
SELECT * FROM types WHERE ts >= '-infinity';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "ts" IS NOT NULL
SELECT * FROM types WHERE d > '-infinity'::date;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "d" IS NOT NULL
SELECT * FROM types WHERE d <= '-infinity'::date;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE 0
SELECT * FROM types WHERE n < 'NaN'::numeric;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "n" IS NOT NULL
SELECT * FROM types WHERE n >= 'Infinity'::numeric;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE 0
SELECT * FROM types WHERE n > '-Infinity'::numeric AND n = 1.50;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "n" IS NOT NULL AND "n" = toDecimal256('1.50', 2)
PREPARE p(timestamp) AS SELECT * FROM types WHERE ts < $1;
EXECUTE p('infinity');
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "ts" IS NOT NULL
EXECUTE p('2026-01-01');
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "ts" < fromUnixTimestamp64Micro(1767225600000000, 'UTC')
-- The other literal branches: integers as written, a bare numeric with its
-- scale, a date and a timestamp without time zone (read as UTC, as the
-- column is), a uuid, and a needle with non-ASCII letters, a newline, quotes
-- and backslashes, for a text and an array column.
SELECT * FROM types WHERE i2 = 1::int2 AND i4 < -2 AND i8 >= 9223372036854775807;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "i2" = 1 AND "i4" < -2 AND "i8" >= 9223372036854775807
SELECT * FROM types WHERE n < 1.500;
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "n" < toDecimal256('1.500', 3)
SELECT * FROM types WHERE d = '1970-01-02' AND ts > '2000-01-01 00:00:00';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "d" = toDate32(1) AND "ts" > fromUnixTimestamp64Micro(946684800000000, 'UTC')
SELECT * FROM types WHERE u = '00000000-0000-0000-0000-000000000001';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE "u" = toUUID('00000000-0000-0000-0000-000000000001')
SELECT id FROM docs WHERE body @@@ E'W\u00f6rter\n''quote'' \\slash' AND tags @@= E'W\u00f6rter\n''quote'' \\slash';
DEBUG:  chdb_search select: SELECT ctid, xmin FROM idx_N.t_N WHERE hasAllTokens("body", 'Wörter
\'quote\' \\slash') AND hasAllTokens("tags", 'Wörter
\'quote\' \\slash')
\o
RESET client_min_messages;
-- The predicates' own answers to NULLs and empty needles: a NULL element is
-- not a match, a NULL array is unknown, an empty array or needle matches
-- nothing.
SELECT ARRAY['a', NULL] @@@ 'a', NULL::text[] @@@ 'a', '{}'::text[] @@= 'a',
       chdb.has_any_tokens('x', ''), chdb.has_phrase('x', '');
 ?column? | ?column? | ?column? | has_any_tokens | has_phrase 
----------+----------+----------+----------------+------------
 t        |          | f        | f              | f
(1 row)

-- The store has no infinities, so the writer refuses them rather than let
-- the encoder wrap them into finite values.
INSERT INTO types (d) VALUES ('infinity');
ERROR:  an infinite date cannot be stored in a chdb index
INSERT INTO types (ts) VALUES ('-infinity');
ERROR:  an infinite timestamp without time zone cannot be stored in a chdb index
INSERT INTO types (n) VALUES ('NaN');
ERROR:  chdb: cannot encode "NaN" as ClickHouse Decimal256(38)
DROP TABLE types;
----------------------------------------------------------------------------
-- ORDER BY a distance operator of the column's family
----------------------------------------------------------------------------
-- Postgres's own point distance stands in for the operators chdb_vector
-- will add; the ClickHouse Point is a tuple, which L2Distance takes.
ALTER OPERATOR FAMILY columnar_ops USING chdb ADD OPERATOR 1 <-> (point, point) FOR ORDER BY float_ops;
SELECT amvalidate(oid) FROM pg_opclass WHERE opcname = 'columnar_ops';
 amvalidate 
------------
 t
(1 row)

CREATE INDEX docs_loc ON docs USING chdb (loc, body);
EXPLAIN (COSTS OFF) SELECT id FROM docs ORDER BY loc <-> '(1,2)' LIMIT 2;
                 QUERY PLAN                 
--------------------------------------------
 Limit
   ->  Index Scan using docs_loc on docs
         Order By: (loc <-> '(1,2)'::point)
(3 rows)

SET client_min_messages = debug1;
\o /dev/null
SELECT id FROM docs ORDER BY loc <-> '(1,2)' LIMIT 2;
DEBUG:  chdb_search select: SELECT ctid, xmin, L2Distance("loc", (1,2)) AS _distance FROM idx_N.t_N ORDER BY _distance
SELECT id FROM docs WHERE body @@@ 'shoes' ORDER BY loc <-> '(1,2)', loc <-> '(3,4)' LIMIT 2;
DEBUG:  chdb_search select: SELECT ctid, xmin, L2Distance("loc", (1,2)) AS _distance1, L2Distance("loc", (3,4)) AS _distance2 FROM idx_N.t_N WHERE hasAllTokens("body", 'shoes') ORDER BY _distance1, _distance2
-- A NULL argument reaches the scan from a generic plan (a custom plan folds
-- the strict operator to NULL and sorts nothing): every row then has a NULL
-- distance, as by seqscan, rather than vanishing.
SET plan_cache_mode = force_generic_plan;
PREPARE near(point) AS SELECT id FROM docs ORDER BY loc <-> $1 LIMIT 1;
EXECUTE near(NULL);
DEBUG:  chdb_search select: SELECT ctid, xmin, CAST(NULL AS Nullable(Float64)) AS _distance FROM idx_N.t_N ORDER BY _distance
EXECUTE near('(3,4)');
DEBUG:  chdb_search select: SELECT ctid, xmin, L2Distance("loc", (3,4)) AS _distance FROM idx_N.t_N ORDER BY _distance
RESET plan_cache_mode;
\o
RESET client_min_messages;
SELECT id FROM docs ORDER BY loc <-> '(1,NaN)' LIMIT 1;
ERROR:  unsupported value in distance argument: "(1,NaN)"
DROP INDEX docs_loc;
ALTER OPERATOR FAMILY columnar_ops USING chdb DROP OPERATOR 1 (point, point);
DROP TABLE docs;
DROP EXTENSION chdb_search;
-- The worker stays connected to the database, which could not be dropped for
-- the next run, so stop it. There is none with the stub client.
DO $$
BEGIN
    PERFORM pg_terminate_backend(pid, 10000)
       FROM pg_stat_activity
      WHERE backend_type = 'chdb_search worker' AND datname = current_database();
END $$;
